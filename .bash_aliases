alias aliases='nvim ~/.bash_aliases'
alias r='ranger_cd'
alias suwofi='sudo wofi -show run'
alias sdn='shutdown now'
alias sdr='shutdown -r now'
alias sps='sudo pacman -Syu'
alias yt='mpv --ytdl-format=22'
alias fight='sh ~/Fightcade/Fightcade2.sh'
alias ll='ls -l'
alias la='ls -la'
alias gs='git status'
alias gp='git push'
alias gpl='git pull'
alias gl='git log'
alias gkde='cd ~/Projects/git/kde-sway-arch'
alias bton='sudo systemctl start bluetooth.service'
alias btoff='sudo systemctl stop bluetooth.service'
alias n='nvim'
alias umbkup='fusermount -u ~/Downloads/encript'
alias kplasma='sudo systemctl start sddm'
